# Inquiry form → ClickUp
# Each submission becomes one task in the list below, with every question and
# answer in the task description. Both must be set in Vercel (Production +
# Preview) and mirrored in .env.local for dev.

# ClickUp personal API token — starts with `pk_`.
# ClickUp → your avatar (bottom left) → Settings → Apps → API Token → Generate.
CLICKUP_API_TOKEN=

# Numeric id of the destination list. Open the list in ClickUp and take the last
# segment of the URL: https://app.clickup.com/<team>/v/li/<CLICKUP_LIST_ID>
CLICKUP_LIST_ID=

# Google Analytics
# GA4 measurement ID (starts with G-). Set per environment in Vercel: the production
# property on Production, a separate test property on Preview + Development. Leave this
# blank locally — an unset value renders no gtag script at all.
GA_MEASUREMENT_ID=

# Search engine indexing
# Leave blank/unset while the site is in test mode — every page renders
# <meta name="robots" content="noindex, nofollow"> and stays out of search results.
# At launch, set this to exactly `true` on Vercel Production (and only Production) and
# redeploy. Preview deployments should keep it unset; Vercel also sends its own
# X-Robots-Tag: noindex on previews.
SITE_LIVE=

# Public site origin, e.g. https://laurelleafdesignstudio.com — no trailing slash.
# Read by lib/site.ts, which feeds metadataBase, every canonical URL, the sitemap, and
# the absolute OG image URLs. Unset, it falls back to Vercel's own deployment URL, and
# locally to http://localhost:3000. Set this on Vercel Production and Preview once the
# domain is pointed; leaving it unset does not fail the build, it just emits canonicals
# that point somewhere useless — so verify on a deployed preview, not in dev.
NEXT_PUBLIC_SITE_URL=
