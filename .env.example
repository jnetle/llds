# Inquiry form → Google Sheets webhook
# Both must be set in Vercel (Production + Preview) and mirrored in .env.local for dev.

# Apps Script Web App URL (Deploy → Web app → copy the URL)
SHEETS_WEBHOOK_URL=

# Long random string. Must match the SHARED_SECRET Script Property in Apps Script.
INQUIRY_SHARED_SECRET=

# Google Analytics
# GA4 measurement ID (starts with G-). Set per environment in Vercel: the production
# property on Production, a separate test property on Preview + Development. Leave this
# blank locally — an unset value renders no gtag script at all.
GA_MEASUREMENT_ID=
